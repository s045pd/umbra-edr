# Umbra EDR — environment configuration template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=umbra
DATABASE_USER=umbra
DATABASE_PASSWORD=__set_a_strong_password__

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Crypto
BCRYPT_ROUNDS=10

# Network ports
API_PORT=8118
WS_PORT=4343
PROXY_PORT=8080

# Filesystem paths (inside container)
GUI_DIST_PATH=/work/gui/dist
EXTENSION_SRC_PATH=/work/extensions
# MEDIA_DIR=/work/media

# Canonical public origin for CRX update XML and the Edge BAT (no trailing slash).
# UMBRA_PUBLIC_URL=https://umbra.example.test

# ── Optional overrides ─────────────────────────────────────────────
# Uncomment and set if the defaults don't match your deployment.

# Run the server in smoke-test mode (no DB, no Redis, no MITM root CA
# generation). Used by `make smoke` and CI dry-runs.
# SKIP_DB=1

# Override the directory where the MITM root CA is read/written.
# Default: ./cassl/ relative to the umbra-server binary's working directory.
# CA_DIR=/var/lib/umbra/cassl

# Specific CA cert file path. Useful when running the server outside Docker
# against an existing root CA. Defaults to <CA_DIR>/rootCA.crt.
# CA_FILE_PATH=/etc/ssl/umbra/rootCA.pem

# Override the directory containing the JS obfuscator tool used by the
# extension packaging pipeline. Default: ./umbra-server/tools/.
# OBFUSCATOR_TOOL_DIR=/opt/umbra/obfuscator
